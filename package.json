{
  "name": "dao-den-long",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "npm run build:headless && npm run build:app && npm run build:ui",
    "build:headless": "esbuild src/headless/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-node/headless/main.js && esbuild src/headless/soak-main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-node/headless/soak.js",
    "build:app": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-node/app.js",
    "app": "node dist-node/app.js",
    "start": "node dist-node/app.js",
    "soak": "node dist-node/headless/soak.js",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot": "esbuild scripts/bot.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-node/bot.js && node dist-node/bot.js",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
